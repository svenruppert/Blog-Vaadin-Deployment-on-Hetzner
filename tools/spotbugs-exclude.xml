<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

  <!--
      CT_CONSTRUCTOR_THROW guards against the finalizer attack: a partially
      constructed object of a non-final class can be resurrected through an
      overridden finalize(). That threat model does not apply here.

      1. Finalization is disabled by default and on its way out on the JDK this
         project targets (maven.compiler.release = 26), so there is no finalizer
         left to attack.
      2. Every view in this template is intentionally non-final — it is a
         starting point meant to be subclassed. Marking the three views the
         detector happens to reach (out of ten equally non-final ones) would be
         arbitrary and would break that contract.

      Scoped to the view layer on purpose: the detector stays active for the
      security and storage packages, where constructor behavior does matter.
  -->
  <Match>
    <Package name="~com\.svenruppert\.flow\.views.*"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

</FindBugsFilter>
