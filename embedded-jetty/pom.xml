<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.svenruppert</groupId>
        <artifactId>vaadinapp</artifactId>
        <version>00.01.00</version>
    </parent>

    <artifactId>vaadinapp-embedded-jetty</artifactId>
    <packaging>jar</packaging>
    <name>Vaadin Deployment on Hetzner — embedded Jetty</name>

    <!--
        The delivery form of article part 3: the application brings its own
        server. There is no installed Jetty any more, no JETTY_HOME, no module
        mechanism - just a main() that assembles Server, connector and context.

        What the module mechanism used to do now has to be written down, and the
        two things that fail *silently* when it is not are:

          - ForwardedRequestCustomizer. Behind Caddy the request arrives from
            127.0.0.1 over plain HTTP. Without the customizer the application
            concludes it is not on HTTPS and drops the Secure flag from the
            session cookie.
          - The websocket container. Vaadin Push needs it; without it the
            connection quietly degrades.

        Packaging is jar. In the single-module layout an embedded launcher had to
        be squeezed out of a war build through the _shadejar profile, which set
        the war execution to phase none and shaded a separate jar. None of that
        is needed here.

        How this jar is then wrapped is the subject of part 4, and it is decided
        by a profile rather than by another module: fat jar and thin distribution
        share this code, these dependencies and these scopes, and differ only in
        the packaging. See the profiles at the bottom of this file.
    -->

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>vaadinapp-core</artifactId>
        </dependency>

        <!--
            Not provided here, unlike in the WAR: this module IS the container,
            so the Servlet API has to be on its runtime classpath.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            The logging binding is a delivery decision, so each packaging module
            names it. It has to be declared here and not just inherited: the
            grandparent POM carries slf4j-simple as a direct test-scope
            dependency, and a direct declaration beats the compile-scope one
            that arrives transitively from core. Without this the packaged
            application finds no SLF4J provider, falls back to the NOP logger
            and starts up completely silent - which hides every later error.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j-api.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- The server itself, versions from the Jetty BOMs in the reactor. -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.ee11</groupId>
            <artifactId>jetty-ee11-webapp</artifactId>
        </dependency>
        <!--
            Supplies the annotation scanner. Vaadin finds its @Route classes
            through RouteRegistryInitializer, a ServletContainerInitializer
            discovered via META-INF/services - which is exactly what this
            scanner walks.
        -->
        <dependency>
            <groupId>org.eclipse.jetty.ee11</groupId>
            <artifactId>jetty-ee11-annotations</artifactId>
        </dependency>
        <!-- Vaadin Push. The external Jetty got this from ee11-websocket-jakarta. -->
        <dependency>
            <groupId>org.eclipse.jetty.ee11.websocket</groupId>
            <artifactId>jetty-ee11-websocket-jakarta-server</artifactId>
        </dependency>

        <!--
            Pin all four ASM modules to one version that understands Java-26
            bytecode. Default resolution mixes asm 9.8 (via j2objc-annotations)
            with asm-tree/asm-commons 9.9.1 (via Jetty); that mix aborts the
            annotation scan with "Unsupported class file major version 70" and
            the WebAppContext never starts. Versions come from the reactor.
        -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-analysis</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.svenruppert.flow.Application</mainClass>
                            <!--
                                Deliberately no addClasspath/classpathPrefix.

                                A manifest Class-Path would make `java -jar` appear to
                                work: the application classloader does resolve the listed
                                jars, so classes load and the server comes up. But
                                java.class.path then contains a single entry - the
                                application jar - and that property is what Jetty's
                                MetaInfConfiguration reads to decide which archives to
                                scan. The annotation scan finds nothing, Vaadin's
                                RouteRegistryInitializer never runs, and the servlet ends
                                up without a StaticFileHandler. The server answers, every
                                request fails with a NullPointerException, and startup
                                takes 139 ms instead of several seconds.

                                Main-Class on its own is kept: without a Class-Path,
                                `java -jar` fails loudly on the first missing class
                                instead of half-working. The name also documents the
                                entry point for anyone reading the archive.

                                The fat jar built by -Pfatjar is the opposite case and
                                the reason both profiles exist: there, one entry on
                                java.class.path is enough, because that one entry holds
                                everything the scan needs to see.
                            -->
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Two packagings of one bootstrap.

        Unlike war-jetty versus embedded-jetty, these two do not differ in code:
        the same Application class, the same dependencies, the same scopes. They
        differ only in how the result is wrapped, which is why they are profiles
        of this module rather than modules of their own. Two modules holding no
        Java code and differing in a plugin block would be scaffolding without
        substance - the very thing the _shadejar profile was criticised for.

            mvn -Pproduction,thin   package     app/, lib/, bin/ and a .tgz
            mvn -Pproduction,fatjar package     one archive, java -jar
            mvn package                         plain jar, for development

        -Pproduction is required for both: without it build-frontend never runs,
        the Vaadin bundle is missing, and Application aborts on its own marker
        check rather than serving a blank page.
    -->
    <profiles>
        <profile>
            <id>thin</id>
            <build>
                <plugins>
                    <!--
                        The plain form: dependencies copied next to the application
                        archive. This is what part 3 delivered and what runs today,
                        started with an explicit classpath:

                            java -cp 'app.jar:lib/*' com.svenruppert.flow.Application
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>collect-libraries</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/lib</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <overWriteIfNewer>true</overWriteIfNewer>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        The packaged form: bin/, app/ and lib/ under one release root,
                        as a directory and as a .tgz. The directory is what gets rsynced
                        to a release folder on the server; the .tgz is the transport
                        form for everything else.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>${maven-assembly-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>thin-distribution</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/thin.xml</descriptor>
                                    </descriptors>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <finalName>vaadinapp-${project.version}-thin</finalName>
                                    <!--
                                        The tar format keeps the 0755 mode of bin/start.sh.
                                        Long file names appear among the dependencies, so
                                        posix rather than the 100-character ustar default.
                                    -->
                                    <tarLongFileMode>posix</tarLongFileMode>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>fatjar</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>shade-application-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <!--
                                        outputFile keeps the shaded archive beside the plain
                                        one instead of replacing the module's primary
                                        artifact. Both forms then exist in target/ at once,
                                        which is what makes them comparable.
                                    -->
                                    <outputFile>${project.build.directory}/vaadinapp-${project.version}-fat.jar</outputFile>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <minimizeJar>false</minimizeJar>
                                    <transformers>
                                        <transformer
                                            implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>com.svenruppert.flow.Application</mainClass>
                                            <manifestEntries>
                                                <!--
                                                    Several dependencies ship classes under
                                                    META-INF/versions/. Without this entry the
                                                    JVM ignores every one of them and silently
                                                    uses the base-version class instead - a
                                                    failure mode with no message at all.
                                                -->
                                                <Multi-Release>true</Multi-Release>
                                            </manifestEntries>
                                        </transformer>
                                        <!--
                                            Merges every META-INF/services/* file across all
                                            archives. Without it they overwrite each other and
                                            ServiceLoader finds one provider where the
                                            application needs all of them - the @JCustosAutoService
                                            entries, the VaadinServiceInitListener, the
                                            AccessEvaluator. Nothing fails at build time.

                                            This transformer is also why the annotation scan
                                            works in the fat jar at all: the initializer it
                                            keeps discoverable is what Jetty runs after the
                                            scan.
                                        -->
                                        <transformer
                                            implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <!--
                                                    Signature files describe the archive they were
                                                    made for. Carried into a different archive they
                                                    no longer match its contents, and the JVM
                                                    rejects the jar with a SecurityException.
                                                -->
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <!--
                                                    One archive can carry one module descriptor.
                                                    Collecting 127 of them leaves whichever won
                                                    last, describing requires/exports of a module
                                                    that no longer exists.
                                                -->
                                                <exclude>module-info.class</exclude>
                                                <exclude>META-INF/versions/*/module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        The fat jar as a release with the same shape as the thin
                        one: bin/, app/, VERSION, no lib/. The start script is byte
                        for byte the same file, so the systemd unit does not change
                        between the two forms and switching from one to the other is
                        a symlink plus a restart. That is what makes them comparable.

                        It works because start.sh puts "app/*:lib/*" on the
                        classpath: with no lib/ directory the second half expands to
                        nothing, and one complete archive is all the annotation scan
                        needs - the very property the fat jar is built on.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>${maven-assembly-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>fat-distribution</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/fat.xml</descriptor>
                                    </descriptors>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <finalName>vaadinapp-${project.version}-fatdist</finalName>
                                    <tarLongFileMode>posix</tarLongFileMode>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
