<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.svenruppert</groupId>
        <artifactId>vaadinapp</artifactId>
        <version>00.01.00</version>
    </parent>

    <artifactId>vaadinapp-core</artifactId>
    <packaging>jar</packaging>
    <name>Vaadin Deployment on Hetzner — Core</name>

    <!--
        Everything the application IS, independent of how it is delivered:
        views, security wiring, persistence, i18n, the tests, and the built
        Vaadin production bundle.

        The frontend is built here and only here. Vaadin's multi-module guidance
        puts vaadin-maven-plugin in the UI module rather than the packaging
        module; the priming build generates the frontend files into the module
        that configures the plugin. For jar packaging the bundle lands in
        target/classes/META-INF/VAADIN/webapp/ and therefore travels inside this
        jar - both the WAR and the embedded launcher pick it up from the
        classpath. Building it twice would be waste; building it in a packaging
        module would put it where the other packaging cannot see it.

        Static files that used to live in src/main/webapp (images, icons) are
        classpath resources under META-INF/resources here, which keeps them
        reachable under the same URLs in both packagings.
    -->

    <dependencies>
        <!--
            Compile against the Servlet API, never ship it: the WAR gets it from
            the container, the embedded launcher promotes it to compile itself.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.vaadin</groupId>
            <!-- vaadin-core = free components only; Hilla disabled -->
            <artifactId>vaadin-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-dev</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-dev-server</artifactId>
                </exclusion>
                <!--
                    Not used by this application and not reachable from any library it
                    ships: the AI components drag in reactor-core (1.8 MB) and the
                    collaboration engine its field highlighter. vaadin-core pulls both
                    through vaadin-core-internal -> vaadin-core-components.

                    In the single-module layout these exclusions had to be repeated in
                    the production profile, because a profile re-declaring the same
                    artifact replaces its exclusion set instead of adding to it. Here
                    the profile no longer re-declares the dependency at all, so one
                    list is enough - and vaadin-dev-server, which the repeated list
                    used to forget, stays excluded under -Pproduction too.
                -->
                <exclusion>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-ai-components-flow</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.vaadin</groupId>
                    <artifactId>collaboration-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.svenruppert</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-core</artifactId>
            <version>${jcustos.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-autoservice-annotations</artifactId>
            <version>${jcustos.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-vaadin</artifactId>
            <version>${jcustos.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-dx</artifactId>
            <version>${jcustos.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-dx-vaadin</artifactId>
            <version>${jcustos.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-vaadin-starter</artifactId>
            <version>${jcustos.version}</version>
        </dependency>
        <!--
            jCustos V00.71 hardening — provides Argon2id via BouncyCastle
            for new password hashes. Legacy PBKDF2 envelopes still verify
            (registry keeps all providers), so the migration is transparent.
            Kept deliberately despite being 35 % of the artifact: dropping it
            would trade the modern hash for disk space.
        -->
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-crypto-bc</artifactId>
            <version>${jcustos.version}</version>
        </dependency>
        <!--
            Have-I-Been-Pwned k-anonymity range check, layered after the
            local blocklist in PasswordPreflight. Plaintext never leaves
            the JVM — only the first 5 hex chars of the SHA-1 hash go
            over the wire. Disabled in tests via -Dapp.hibp.enabled=false
            (Surefire <systemPropertyVariables>), enabled in production
            by default; network outage = Indeterminate = allow
            (CWE-359 fail-open).
        -->
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-credentials-hibp</artifactId>
            <version>${jcustos.version}</version>
        </dependency>
        <!--
            Layer-2 persistence — Eclipse-Store-backed audit / session /
            user / bootstrap-state stores. Survives JVM restarts.
        -->
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-persistence-eclipsestore</artifactId>
            <version>${jcustos.version}</version>
        </dependency>

        <!--
            Vaadin 25.1.1 pulls in tools.jackson.core:jackson-databind:3.1.x transitively
            via flow-server. That databind release loads com.fasterxml.jackson.annotation.JsonSerializeAs
            (Jackson 2) in its static initializer as a migration bridge — without this
            dependency on the classpath, prepare-frontend crashes with NoClassDefFoundError.
            Remove only when Vaadin ships a flow-server release that no longer triggers
            the Jackson 2 fallback path.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.22</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>log4j-over-slf4j</artifactId>
            <version>${slf4j-api.version}</version>
        </dependency>

        <!--
            Browserless Vaadin testing — free since Vaadin 25.1. Pulls
            JUnit Jupiter 6.x transitively into the test classpath.
            Used by tests under junit.com.svenruppert.*
        -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-junit6</artifactId>
            <version>1.1.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                prepare-frontend always, build-frontend only under -Pproduction.

                In the single-module layout both goals ran in every build, because
                the execution declared in the production profile carried the same
                implicit id (default) as the base execution and merged with it.
                The profile therefore made no difference at all, although the
                articles describe `mvn -Pproduction clean package` as *the*
                production build. Giving the profile execution its own id restores
                the documented behaviour and shortens the development build.
            -->
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <id>prepare</id>
                        <goals>
                            <goal>prepare-frontend</goal>
                        </goals>
                        <phase>compile</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Path order matters on JDK 21+: *-processor BEFORE *-annotations.
                        Reversed order causes silent no-emit of META-INF/services entries
                        for @JCustosAutoService.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>eu.jsentinel</groupId>
                            <artifactId>jCustos-autoservice-processor</artifactId>
                            <version>${jcustos.version}</version>
                        </path>
                        <path>
                            <groupId>eu.jsentinel</groupId>
                            <artifactId>jCustos-autoservice-annotations</artifactId>
                            <version>${jcustos.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <!--<goal>jar</goal> do not define it here again !!-->
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Redirect all persistence the app touches into the build
                        directory. Tests run with app.storage.dir pointing at
                        target/test-data, so no test ever creates the
                        repo-rooted ./data/ tree. mvn clean wipes it.
                        See com.svenruppert.flow.security.storage.AppStoragePaths.
                    -->
                    <systemPropertyVariables>
                        <app.storage.dir>${project.build.directory}/test-data</app.storage.dir>
                        <!--
                            Disable HIBP network calls in tests. Otherwise every
                            non-blocklisted password check waits ~5s for the JDK
                            HttpClient timeout. Production runs leave this unset
                            (default = enabled).
                        -->
                        <app.hibp.enabled>false</app.hibp.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                The parent POM runs spotbugs:check at verify. Since parent
                06.02.05 (SpotBugs 4.10.2.0) the CT_CONSTRUCTOR_THROW detector
                reaches the view layer; see tools/spotbugs-exclude.xml for why
                that one detector is scoped out there and nowhere else.
                The path is reactor-rooted - tools/ lives next to the reactor
                POM, not inside the modules.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <excludeFilterFile>${tools.dir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>

            <!--Enable mutation testing-->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!--
                        PIT forks its own minion JVMs and does not pick up the
                        surefire <systemPropertyVariables> above, so without this
                        the mutation run falls back to the production default and
                        writes the repo-rooted ./data/ tree, violating the
                        AppStoragePaths invariant.

                        The directory is deliberately NOT surefire's test-data:
                        PIT drives the suite from its own minion JVMs and leaves
                        a store behind that a subsequent plain `mvn test` cannot
                        reopen (ServiceConfigurationError on
                        PersistenceBootstrapExtension). Giving each runner its
                        own tree keeps both idempotent; `mvn clean` wipes both.
                    -->
                    <jvmArgs>
                        <jvmArg>-Dapp.storage.dir=${project.build.directory}/pit-test-data</jvmArg>
                        <jvmArg>-Dapp.hibp.enabled=false</jvmArg>
                    </jvmArgs>
                    <threads>2</threads>
                    <outputFormats>
                        <outputFormat>XML</outputFormat>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <targetClasses>
                        <param>${pitest-prod-classes}</param>
                    </targetClasses>
                    <targetTests>
                        <param>${pitest-test-classes}</param>
                    </targetTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <!--
            Mutation-coverage floor. Runs after pitest and compares the report
            against tools/pit-baselines.txt:
              ./mvnw -P_mutation-gate org.pitest:pitest-maven:mutationCoverage verify
            Script and baselines live in the reactor root, hence ${tools.dir}.
        -->
        <profile>
            <id>_mutation-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>enforce-mutation-floor</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${tools.dir}/pit-gate.sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <id>bundle</id>
                                <goals>
                                    <goal>build-frontend</goal>
                                </goals>
                                <phase>compile</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
